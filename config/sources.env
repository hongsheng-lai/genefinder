# genefinder data sources: every remote input the pipeline reads.
# Sourced by run.sh / scripts/setup.sh / scripts/check_sources.sh; override any variable in the
# environment before running (e.g. export PAF_URL=... to use another alignment set).
# All URLs are public HTTPS; no AWS account or credentials are needed.
# Run `scripts/check_sources.sh` to verify they are reachable and unchanged (size / ETag below).
# See docs/DATA_SOURCES.md for what each file is and how it is used.

# Public HPRC bucket (s3://human-pangenomics), anonymous HTTPS endpoint.
# Browse: https://human-pangenomics.s3.amazonaws.com/index.html   list: scripts/s3ls.py <prefix>
: "${HPRC_BUCKET:=https://human-pangenomics.s3.amazonaws.com}"

# HPRC Release 2: all 465 haplotypes (464 HPRC + GRCh38) aligned to CHM13 v2.0, PanSN names, cg:Z CIGARs.
# 5,590,221,127 bytes, BGZF-compressed, ETag fbacddb3eb2fcb399a9202e8eab2108a-667.
# Never downloaded by default: setup reads it once to build a small offset index, and runs then fetch only
# the records overlapping the requested genes with HTTP range requests (--mode remote).
: "${PAF_URL:=$HPRC_BUCKET/pangenomes/freeze/release2/impg/pafs/hprc465vschm13.aln.paf.gz}"

# HPRC Release 2 assembly index (sample, haplotype, S3 paths of the bgzipped FASTA + .fai + .gzi).
# Pinned to commit 2a7e3a5 (2025-10-03) of human-pangenomics/hprc_intermediate_assembly; md5 90c9e66a58580484facd59d3ed28c52c
: "${ASSEMBLY_INDEX_URL:=https://raw.githubusercontent.com/human-pangenomics/hprc_intermediate_assembly/2a7e3a5b1ca10454762699176b1a0a1027ccbf21/data_tables/assemblies_release2_v1.0.index.csv}"

# CHM13 v2.0 gene annotations (GFF3).
: "${ANNOTATION_BASE_URL:=$HPRC_BUCKET/T2T/CHM13/assemblies/annotation}"
# GENCODE v35 via CAT/Liftoff (default), 158,318,946 bytes (+ .tbi)
: "${GENCODE_GFF3:=chm13v2.0_GENCODEv35_CAT_Liftoff.vep.gff3.gz}"
# RefSeq genes lifted to CHM13 with Liftoff ("v5.2" annotation release), 56,368,414 bytes
: "${REFSEQ_GFF3:=chm13v2.0_RefSeq_Liftoff_v5.2.gff3.gz}"

# CHM13 analysis set (PanSN names, chrY PARs hard-masked) - used for the CHM13 control sequence and
# chromosome sizes. The assembly index above lists the same URL.
: "${CHM13_FASTA_URL:=$HPRC_BUCKET/working/HPRC_PLUS/CHM13/assemblies/analysis_set/pansn/chm13v2.0_maskedY_rCRS.fa.PanSN.fa.gz}"

# Optional alternatives in the same release folder (not used by default):
#   $HPRC_BUCKET/pangenomes/freeze/release2/impg/pafs/hprc465vsgrch38.aln.paf.gz   (vs GRCh38, 6.3 GB)
#   $HPRC_BUCKET/pangenomes/freeze/release2/impg/tpas/                            (per-haplotype .tpa)
#   $HPRC_BUCKET/pangenomes/freeze/release2/minigraph-cactus/hprc-v2.0-mc-chm13.gbz (graph, 5.7 GB)

# Local mirror of the 466 Release 2 assemblies (same file names as the index, with .fai + .gzi).
# run.sh reads sequences from here instead of S3 when the directory exists (--fasta-dir overrides).
# Default: the Salz cluster copy (466 assemblies, downloaded 2026-10-23).
: "${LOCAL_FASTA_DIR:=/ccb/salz8/HPRC/assemblies/fasta}"

export LOCAL_FASTA_DIR HPRC_BUCKET PAF_URL ASSEMBLY_INDEX_URL ANNOTATION_BASE_URL GENCODE_GFF3 REFSEQ_GFF3 CHM13_FASTA_URL
